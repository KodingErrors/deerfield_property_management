# Reference copy of the three variables the inquiry endpoint reads.
#
#   Local  ->  put real values in .dev.vars (git-ignored), then run `npm start`
#   Vercel ->  add them under Project Settings > Environment Variables
#
# Nothing reads this file at runtime; it documents the names. Never put a real key
# here -- this file is committed.

# Resend API key. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. Resend's free tier, with no verified domain, only sends from
# onboarding@resend.dev -- a display name in front of it is fine.
RESEND_FROM_EMAIL=Deerfield Deal Desk <onboarding@resend.dev>

# Destination for contact-form inquiries. On Resend's free tier without a verified
# domain this must be the email that owns the Resend account. If unset or malformed,
# the worker falls back to DEFAULT_RECIPIENT in dist/inquiry-format.js.
INQUIRY_RECIPIENT=raiyanworks@gmail.com
