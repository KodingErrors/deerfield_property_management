# dependencies
/node_modules

# env files: wrangler reads local secrets from .dev.vars, never .env
.env*
!.env.example
.dev.vars

# generated by `npm run build` (dist/ itself is hand-written source)
/dist/client/
/dist/server/
/dist/.openai/

# local runtime state
/.wrangler/
/.sites-runtime/
/.npm-cache/
/.vercel/
/outputs/
/work/
/.agents/
/.codex/

# misc
.DS_Store
*.pem
npm-debug.log*
